# ============================================================
# Railway Environment Variables for PostgREST Service
# Docker Image: postgrest/postgrest:latest
# ============================================================

# Database connection using Railway internal network
# Format: postgres://authenticator:<password>@postgres.railway.internal:5432/<database_name>
PGRST_DB_URI=postgres://authenticator:railway_postgrest_pass@postgres.railway.internal:5432/risk_aml

# Exposed database schemas
PGRST_DB_SCHEMAS=public

# Default anonymous database role (switched to when anon JWT is used)
PGRST_DB_ANON_ROLE=anon

# Secret key used to verify incoming JWT tokens (must be >= 32 characters)
PGRST_JWT_SECRET=replace_with_a_random_string_of_at_least_32_characters

# Internal port
PGRST_SERVER_PORT=3000
PORT=3000
